{
  "scripts": {
    "dev": {
      "type": "script",
      "command": "set -euo pipefail\npaseo script start backend\npaseo script start frontend"
    },
    "frontend": {
      "type": "service",
      "command": "VITE_BACKEND_URL=http://127.0.0.1:$PASEO_SERVICE_BACKEND_PORT pnpm dev --host 127.0.0.1 --port $PASEO_PORT"
    },
    "backend": {
      "type": "service",
      "command": "WEB_ORIGIN=$PASEO_SERVICE_FRONTEND_URL uv run uvicorn backend.app:app --host 127.0.0.1 --port $PASEO_PORT --reload"
    }
  }
}
